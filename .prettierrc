{
  "printWidth": 160,
  "tabWidth": 4,
  "useTabs": false,
  "singleQuote": false,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    { "files": "*.svelte", "options": { "parser": "svelte", "tabWidth": 2 } },
    { "files": ["*.json", "*.yml", "*.yaml", "*.md"], "options": { "tabWidth": 2 } }
  ]
}
