{
  "name": "intrus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite dev",
    "dev:online": "node scripts/dev-online.mjs",
    "dev:tunnel": "vite dev --mode tunnel",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p server/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "party:dev": "wrangler dev --config server/wrangler.toml",
    "party:deploy": "wrangler deploy --config server/wrangler.toml",
    "test:workers": "vitest run --config server/vitest.workers.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "words:generate": "node scripts/words/words.mjs generate",
    "words:wikidata": "node scripts/words/words.mjs wikidata",
    "words:status": "node scripts/words/words.mjs status",
    "words:apply": "node scripts/words/words.mjs apply",
    "words:check": "node scripts/words/words.mjs check",
    "map": "node scripts/file-map.mjs",
    "lighthouse": "npx --yes lighthouse http://localhost:4173 --form-factor=mobile --view"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "partyserver": "^0.5.10",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  }
}
